Windows Registry Editor Version 5.00

; Selects the original Afterglow visual style (colour "Dusk", size "Normal") for the current user, with its caption metrics.
; The colour block tunes only the title colours of the classic scheme; every colour an application's client area uses stays the classic
; cream scheme.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ThemeActive"="1"
"DllName"="C:\\ReactOS\\Resources\\Themes\\Afterglow\\afterglow.msstyles"
"ColorName"="Dusk"
"SizeName"="Normal"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="31 37 84"
"GradientActiveTitle"="122 69 98"
"InactiveTitle"="20 22 29"
"GradientInactiveTitle"="27 30 40"
"TitleText"="255 255 255"
"InactiveTitleText"="124 135 150"

; The desktop and selection colours, then the console's colour table (HKCU\Console, read by each new console window), both generated
; from the Dusk scheme's palette; `build.sh --schemes` rewrites this block.
; BEGIN generated by gen.py (desktop and selection colours, console colours)
[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="9 14 42"
"Hilight"="66 57 108"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:0030120a
"ColorTable01"=dword:00f2957f
"ColorTable02"=dword:009acf86
"ColorTable03"=dword:00d6c662
"ColorTable04"=dword:005e3ff4
"ColorTable05"=dword:00e68bc9
"ColorTable06"=dword:0040aaff
"ColorTable07"=dword:00d8e2e9
"ColorTable08"=dword:0096877c
"ColorTable09"=dword:00ffb8a9
"ColorTable10"=dword:00c0efb0
"ColorTable11"=dword:00f0e698
"ColorTable12"=dword:00a695f9
"ColorTable13"=dword:00f8b8e4
"ColorTable14"=dword:008ed0ff
"ColorTable15"=dword:00eaf7ff
"ScreenColors"=dword:00000007
"PopupColors"=dword:000000e0
; END generated by gen.py

; Caption metrics, in negative twips (-15 per pixel at 96 dpi), read by win32k at logon. SM_CYCAPTION becomes 25 and SM_CYSIZE
; 24; the theme engine then draws the title in a 14 px box, so an 8 pt bold title is never clipped. Small (tool window)
; captions get 23. The frame (BorderWidth) and the fonts stay as they are; ReactOS 0.4.16 has no PaddedBorderWidth.
[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
"CaptionHeight"="-360"
"CaptionWidth"="-360"
"SmCaptionHeight"="-345"
"SmCaptionWidth"="-345"
