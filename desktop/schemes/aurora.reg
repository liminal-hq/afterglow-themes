Windows Registry Editor Version 5.00

; Afterglow colour scheme "Aurora", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Aurora"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="14 34 56"
"GradientActiveTitle"="75 61 134"
"InactiveTitle"="15 21 32"
"GradientInactiveTitle"="21 29 43"
"TitleText"="255 255 255"
"InactiveTitleText"="123 138 156"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="8 20 34"
"Hilight"="19 100 102"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:001e1107
"ColorTable01"=dword:00f0987a
"ColorTable02"=dword:009adc6f
"ColorTable03"=dword:00e6c45b
"ColorTable04"=dword:008a6aef
"ColorTable05"=dword:00d07fcf
"ColorTable06"=dword:007ad2e8
"ColorTable07"=dword:00e5e8df
"ColorTable08"=dword:009c8a7b
"ColorTable09"=dword:00ffbca8
"ColorTable10"=dword:00bcf0a0
"ColorTable11"=dword:00f6e092
"ColorTable12"=dword:00b69fff
"ColorTable13"=dword:00e8a8e8
"ColorTable14"=dword:00a6e8f6
"ColorTable15"=dword:00fafdf3
"ScreenColors"=dword:00000007
"PopupColors"=dword:000000e0
