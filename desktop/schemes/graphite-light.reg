Windows Registry Editor Version 5.00

; Afterglow colour scheme "Graphite Light", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Graphite Light"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="242 242 243"
"GradientActiveTitle"="204 200 196"
"InactiveTitle"="232 232 234"
"GradientInactiveTitle"="246 246 247"
"TitleText"="30 33 38"
"InactiveTitleText"="92 95 102"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="174 175 178"
"Hilight"="63 66 71"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:0026211e
"ColorTable01"=dword:009c4834
"ColorTable02"=dword:00246a2e
"ColorTable03"=dword:00746a18
"ColorTable04"=dword:002c32a8
"ColorTable05"=dword:008a3882
"ColorTable06"=dword:0010547a
"ColorTable07"=dword:004e4845
"ColorTable08"=dword:00665f5c
"ColorTable09"=dword:00b45844
"ColorTable10"=dword:00307e3a
"ColorTable11"=dword:0082781c
"ColorTable12"=dword:00363cc0
"ColorTable13"=dword:00a24898
"ColorTable14"=dword:0014648e
"ColorTable15"=dword:00f7f6f6
"ScreenColors"=dword:000000f0
"PopupColors"=dword:0000000f
