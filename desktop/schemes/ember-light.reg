Windows Registry Editor Version 5.00

; Afterglow colour scheme "Ember Light", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Ember Light"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="247 227 211"
"GradientActiveTitle"="228 171 156"
"InactiveTitle"="237 228 223"
"GradientInactiveTitle"="248 241 236"
"TitleText"="43 19 48"
"InactiveTitleText"="106 88 82"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="184 162 150"
"Hilight"="140 48 52"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:00181c2b
"ColorTable01"=dword:009e4834
"ColorTable02"=dword:001c6a45
"ColorTable03"=dword:00686a12
"ColorTable04"=dword:002f18a8
"ColorTable05"=dword:007a3092
"ColorTable06"=dword:0010507a
"ColorTable07"=dword:0040465a
"ColorTable08"=dword:0052586a
"ColorTable09"=dword:00b85c44
"ColorTable10"=dword:00207450
"ColorTable11"=dword:00707618
"ColorTable12"=dword:003822c4
"ColorTable13"=dword:009440aa
"ColorTable14"=dword:0014608e
"ColorTable15"=dword:00ecf1f8
"ScreenColors"=dword:000000f0
"PopupColors"=dword:0000000f
