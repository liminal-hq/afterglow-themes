Windows Registry Editor Version 5.00

; Afterglow colour scheme "Aurora Light", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Aurora Light"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="223 243 239"
"GradientActiveTitle"="216 203 234"
"InactiveTitle"="228 233 239"
"GradientInactiveTitle"="243 246 249"
"TitleText"="14 34 56"
"InactiveTitleText"="82 97 122"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="158 176 184"
"Hilight"="19 100 102"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:00332014
"ColorTable01"=dword:00a84a2c
"ColorTable02"=dword:004c6a17
"ColorTable03"=dword:0080650e
"ColorTable04"=dword:006c30a8
"ColorTable05"=dword:009c3a84
"ColorTable06"=dword:000c5a74
"ColorTable07"=dword:00624e3e
"ColorTable08"=dword:007a6152
"ColorTable09"=dword:00c05c3c
"ColorTable10"=dword:005a7a1d
"ColorTable11"=dword:008f7414
"ColorTable12"=dword:00803cc0
"ColorTable13"=dword:00b6489c
"ColorTable14"=dword:00106a88
"ColorTable15"=dword:00f9f6f3
"ScreenColors"=dword:000000f0
"PopupColors"=dword:0000000f
