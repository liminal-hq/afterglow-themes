Windows Registry Editor Version 5.00

; Afterglow colour scheme "Graphite", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Graphite"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="30 33 38"
"GradientActiveTitle"="88 84 81"
"InactiveTitle"="22 23 25"
"GradientInactiveTitle"="29 31 34"
"TitleText"="255 255 255"
"InactiveTitleText"="133 138 145"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="18 19 22"
"Hilight"="63 66 71"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:0013100f
"ColorTable01"=dword:00d8987f
"ColorTable02"=dword:007ac98e
"ColorTable03"=dword:00c9c35f
"ColorTable04"=dword:005a60e8
"ColorTable05"=dword:00c48ac5
"ColorTable06"=dword:0040aaff
"ColorTable07"=dword:00d8e2e9
"ColorTable08"=dword:00918a85
"ColorTable09"=dword:00f0bca8
"ColorTable10"=dword:00a2e6b4
"ColorTable11"=dword:00e6e294
"ColorTable12"=dword:00949aff
"ColorTable13"=dword:00e0b0e2
"ColorTable14"=dword:008ed0ff
"ColorTable15"=dword:00eaf7ff
"ScreenColors"=dword:00000007
"PopupColors"=dword:000000e0
