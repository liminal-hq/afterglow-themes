Windows Registry Editor Version 5.00

; Afterglow colour scheme "Ember", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Ember"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="43 19 48"
"GradientActiveTitle"="171 75 58"
"InactiveTitle"="28 21 19"
"GradientInactiveTitle"="36 27 24"
"TitleText"="255 255 255"
"InactiveTitleText"="150 135 130"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="25 12 26"
"Hilight"="140 48 52"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:00160a15
"ColorTable01"=dword:00e0937d
"ColorTable02"=dword:006ac9a6
"ColorTable03"=dword:00b8c15c
"ColorTable04"=dword:005b5fee
"ColorTable05"=dword:00b578d2
"ColorTable06"=dword:008ad5f3
"ColorTable07"=dword:00dfe6e9
"ColorTable08"=dword:00828796
"ColorTable09"=dword:00f4b8a8
"ColorTable10"=dword:0092e5c8
"ColorTable11"=dword:00d8e092
"ColorTable12"=dword:00949aff
"ColorTable13"=dword:00d29fec
"ColorTable14"=dword:00b8e7fa
"ColorTable15"=dword:00f3fbfe
"ScreenColors"=dword:00000007
"PopupColors"=dword:000000e0
