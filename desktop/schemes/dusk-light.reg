Windows Registry Editor Version 5.00

; Afterglow colour scheme "Dusk Light", generated by gen.py: selects it in the theme manager (the style itself is selected by
; afterglow-original.reg) and sets the classic scheme's six title colours, desktop colour and selection colours to match, and the
; console's colour table. The theme takes effect at the next logon (picking the scheme in Display Properties, Appearance applies it
; at once); the console colours are read by each new console window.
;
; (c) Copyright 2026 Liminal HQ, Scott Morris
; SPDX-License-Identifier: Apache-2.0 OR MIT

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ColorName"="Dusk Light"

[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="246 220 200"
"GradientActiveTitle"="208 198 226"
"InactiveTitle"="230 225 234"
"GradientInactiveTitle"="246 241 234"
"TitleText"="31 37 84"
"InactiveTitleText"="94 88 112"

[HKEY_CURRENT_USER\Control Panel\Colors]
"Background"="176 160 164"
"Hilight"="66 57 108"
"HilightText"="255 255 255"

[HKEY_CURRENT_USER\Console]
"ColorTable00"=dword:0033241f
"ColorTable01"=dword:00b0462c
"ColorTable02"=dword:003c6e1f
"ColorTable03"=dword:007c6814
"ColorTable04"=dword:003c20a8
"ColorTable05"=dword:009e3a8a
"ColorTable06"=dword:00105a8a
"ColorTable07"=dword:00664f4a
"ColorTable08"=dword:0070585e
"ColorTable09"=dword:00c8583a
"ColorTable10"=dword:00497a25
"ColorTable11"=dword:0089741a
"ColorTable12"=dword:004a2ac4
"ColorTable13"=dword:00b848a0
"ColorTable14"=dword:00126494
"ColorTable15"=dword:00eaf1f6
"ScreenColors"=dword:000000f0
"PopupColors"=dword:0000000f
